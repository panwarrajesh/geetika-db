# Copy to .env and edit. NEVER commit .env (it is in .gitignore). No real secrets in this file.

# --- web / TLS ---------------------------------------------------------------
SITE_ADDRESS=console.example.com        # your domain (DNS A/AAAA record must point to this server) or "localhost" for a local test
OPS_ALLOW_IPS=127.0.0.1                 # who may open the Operations page; put YOUR public IP here (space separated)

# --- storage -----------------------------------------------------------------
DATA_MOUNT=/srv/rajeshdb-data           # host folder for ALL data and backups; create it and chown 10001:10001

# --- secrets -----------------------------------------------------------------
# Generate with:  openssl rand -hex 32
RAJESHDB_OPERATOR_TOKEN=CHANGE_ME_generate_a_long_random_value

# --- behaviour ---------------------------------------------------------------
RAJESHDB_ALLOW_REGISTRATION=true        # set to false once your own account exists, if this is a private deployment
RAJESHDB_PROJECT_QUOTA_BYTES=104857600  # 100 MiB per project environment
RAJESHDB_BACKUP_INTERVAL_SECS=21600     # every 6 hours
RAJESHDB_BACKUP_RETENTION=7
RAJESHDB_DISK_BUDGET_BYTES=10000000000  # alert at 80%/95% of 10 GB of data+backups; size this below your real disk
RAJESHDB_ARGON_MEMORY_KIB=19456
RAJESHDB_SYNC_WRITES=true
RAJESHDB_SESSION_TTL_SECS=86400
